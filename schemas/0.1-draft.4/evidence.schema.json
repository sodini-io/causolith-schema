{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sodini-io/project-canon-schema/main/schemas/0.1-draft.4/evidence.schema.json",
  "title": "Project Canon evidence manifest (private draft 0.1-draft.4)",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "canon_id", "evidence_id", "created_at", "original", "provenance", "presentation", "extensions"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"}, "format_version": {"const": "0.1-draft.4"},
    "canon_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "evidence_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "created_at": {"type": "string", "format": "date-time"},
    "original": {"$ref": "#/$defs/original"}, "provenance": {"$ref": "#/$defs/provenance"}, "presentation": {"$ref": "#/$defs/presentation"}, "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "client", "task_id"], "properties": {"type": {"enum": ["human", "agent", "system"]}, "client": {"type": "string"}, "task_id": {"type": "string"}}},
    "original": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "byte_count", "mime_type", "filename", "storage"], "properties": {"kind": {"enum": ["file", "screenshot", "text", "test_output", "code", "commit", "link"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byte_count": {"type": "integer", "minimum": 0}, "mime_type": {"type": "string", "minLength": 1, "maxLength": 255}, "filename": {"type": "string", "minLength": 1, "maxLength": 255}, "storage": {"enum": ["embedded", "git_lfs", "external", "omitted"]}, "locator": {"type": ["string", "null"], "maxLength": 8192}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["actor"], "properties": {"actor": {"$ref": "#/$defs/actor"}, "repository_path": {"type": ["string", "null"]}, "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"}, "line_start": {"type": ["integer", "null"], "minimum": 1}, "line_end": {"type": ["integer", "null"], "minimum": 1}, "locator": {"type": ["string", "null"], "maxLength": 8192}, "captured_title": {"type": ["string", "null"]}}},
    "annotation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "start_x", "start_y", "end_x", "end_y", "color"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["arrow", "rectangle", "text"]}, "start_x": {"type": "number", "minimum": 0, "maximum": 1}, "start_y": {"type": "number", "minimum": 0, "maximum": 1}, "end_x": {"type": "number", "minimum": 0, "maximum": 1}, "end_y": {"type": "number", "minimum": 0, "maximum": 1}, "text": {"type": ["string", "null"], "maxLength": 2048}, "color": {"type": "string"}}},
    "presentation": {"type": "object", "additionalProperties": false, "required": ["role", "caption", "caption_actor", "annotations", "target_record_ids"], "properties": {"role": {"enum": ["reference", "before", "proposed", "failure", "shipped", "verification"]}, "caption": {"type": "string", "maxLength": 65536}, "caption_actor": {"$ref": "#/$defs/actor"}, "comparison_group": {"type": ["string", "null"]}, "annotations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/annotation"}}, "target_record_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}
  }
}
