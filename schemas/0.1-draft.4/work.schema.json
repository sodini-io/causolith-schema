{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sodini-io/project-canon-schema/main/schemas/0.1-draft.4/work.schema.json",
  "title": "Project Canon work content (private draft 0.1-draft.4)",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "state", "title", "problem", "intended_outcome", "acceptance_notes", "outcome", "area_ids", "tag_ids", "commit_shas", "changed_paths", "verification", "visual_change", "followups", "extensions"],
  "properties": {
    "kind": {"enum": ["defect", "idea", "change", "investigation"]}, "state": {"enum": ["inbox", "ready", "active", "blocked", "done", "abandoned"]}, "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "problem": {"type": "string", "maxLength": 65536}, "intended_outcome": {"type": "string", "maxLength": 65536}, "acceptance_notes": {"type": "string", "maxLength": 65536}, "outcome": {"type": "string", "maxLength": 65536},
    "area_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}, "tag_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}},
    "commit_shas": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"}}, "changed_paths": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "string", "maxLength": 65536}, "visual_change": {"type": "boolean"}, "followups": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 65536}}, "extensions": {"type": "object", "additionalProperties": true}
  }
}
