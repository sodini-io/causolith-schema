{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sodini-io/project-canon-schema/main/schemas/0.1-draft.4/operation.schema.json",
  "title": "Project Canon immutable operation (private draft 0.1-draft.4)",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "canon_id", "operation_id", "record_id", "record_key", "parents", "kind", "actor", "occurred_at", "payload", "extensions"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"}, "format_version": {"const": "0.1-draft.4"},
    "canon_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "operation_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "record_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "record_key": {"type": "string", "pattern": "^(?:|[A-Z][A-Z0-9]{2,7}-[0-9A-HJKMNP-TV-Z]{12})$"},
    "parents": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}},
    "kind": {"enum": ["decision.proposed", "decision.revised", "decision.accepted", "decision.rejected", "decision.judgment_resolved", "decision.superseded", "evidence.revised", "evidence.redacted", "work.created", "work.revised", "work.note_added", "work.finished", "work.abandoned", "work.reopened", "area.created", "area.revised", "area.archived", "area.restored", "tag.created", "tag.revised", "tag.merged", "intent_review.recorded", "intent_review.resolved", "relation.added", "relation.removed"]},
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "client", "task_id"], "properties": {"type": {"enum": ["human", "agent", "system"]}, "client": {"type": "string"}, "task_id": {"type": "string"}}},
    "occurred_at": {"type": "string", "format": "date-time"}, "payload": {}, "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "client", "task_id"], "properties": {"type": {"enum": ["human", "agent", "system"]}, "client": {"type": "string"}, "task_id": {"type": "string"}}},
    "empty": {"type": "object", "additionalProperties": false},
    "state_change": {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string", "maxLength": 65536}}},
    "reason": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 65536}}},
    "rejected": {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string", "maxLength": 65536}}},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["outcome"], "properties": {"outcome": {"type": "string", "minLength": 1, "maxLength": 65536}}},
    "accepted": {"type": "object", "additionalProperties": false, "required": ["selected_clause_ids", "selected_exception_ids"], "properties": {"selected_clause_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "selected_exception_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reason": {"type": "string", "maxLength": 65536}}},
    "judgment_resolution": {"type": "object", "additionalProperties": false, "required": ["selected_operation_id"], "properties": {"selected_operation_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "reason": {"type": "string", "maxLength": 65536}}},
    "supersession": {"type": "object", "additionalProperties": false, "required": ["replacement_decision_id"], "properties": {"replacement_decision_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "reason": {"type": "string", "maxLength": 65536}}},
    "note": {"type": "object", "additionalProperties": false, "required": ["note"], "properties": {"note": {"type": "object", "additionalProperties": false, "required": ["text", "actor", "created_at", "extensions"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 65536}, "actor": {"$ref": "#/$defs/actor"}, "created_at": {"type": "string", "format": "date-time"}, "extensions": {"type": "object", "additionalProperties": true}}}}},
    "tag_merge": {"type": "object", "additionalProperties": false, "required": ["target_tag_id"], "properties": {"target_tag_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}},
    "review_resolution": {"type": "object", "additionalProperties": false, "required": ["resolutions"], "properties": {"resolutions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "kind", "rationale"], "properties": {"conflict_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["dismissed", "accepted_exception"]}, "rationale": {"type": "string", "minLength": 1, "maxLength": 65536}, "exception_decision_id": {"type": "string", "format": "uuid"}}}}}},
    "relation_removal": {"type": "object", "additionalProperties": false, "required": ["add_operation_ids"], "properties": {"add_operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}},
    "evidence_revision": {"type": "object", "additionalProperties": false, "required": ["base_manifest_sha256", "presentation", "extensions"], "properties": {"base_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "presentation": {"$ref": "evidence.schema.json#/$defs/presentation"}, "extensions": {"type": "object", "additionalProperties": true}}},
    "evidence_redaction": {"type": "object", "additionalProperties": false, "required": ["base_manifest_sha256", "reason"], "properties": {"base_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reason": {"type": "string", "minLength": 1, "maxLength": 65536}}},
    "intent_review": {"type": "object", "additionalProperties": false, "required": ["request", "area_ids", "tag_ids", "changed_paths", "consulted_standards", "related_decision_ids", "assessment", "proposed_conflicts", "source_fingerprint", "trust_policy_fingerprint", "resolutions", "extensions"], "properties": {"request": {"type": "string", "minLength": 1, "maxLength": 65536}, "area_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}, "tag_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}, "changed_paths": {"type": "array", "uniqueItems": true, "maxItems": 1000, "items": {"type": "string", "minLength": 1}}, "consulted_standards": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "activation_operation_id"], "properties": {"reference": {"$ref": "decision-content.schema.json#/$defs/reference"}, "activation_operation_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}, "related_decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}, "assessment": {"type": "string", "maxLength": 65536}, "proposed_conflicts": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["id", "description", "standard_refs"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1, "maxLength": 65536}, "standard_refs": {"type": "array", "items": {"$ref": "decision-content.schema.json#/$defs/reference"}}}}}, "source_fingerprint": {"type": "string", "maxLength": 256}, "trust_policy_fingerprint": {"type": "string", "maxLength": 256}, "resolutions": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "kind", "rationale"], "properties": {"conflict_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["dismissed", "accepted_exception"]}, "rationale": {"type": "string", "minLength": 1, "maxLength": 65536}, "exception_decision_id": {"type": "string", "format": "uuid"}}}}, "extensions": {"type": "object", "additionalProperties": true}}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"enum": ["decision.proposed", "decision.revised"]}}}, "then": {"properties": {"payload": {"$ref": "decision-content.schema.json"}}}},
    {"if": {"properties": {"kind": {"enum": ["work.created", "work.revised"]}}}, "then": {"properties": {"payload": {"$ref": "work.schema.json"}}}},
    {"if": {"properties": {"kind": {"enum": ["area.created", "area.revised"]}}}, "then": {"properties": {"payload": {"$ref": "graph.schema.json#/$defs/area"}}}},
    {"if": {"properties": {"kind": {"enum": ["tag.created", "tag.revised"]}}}, "then": {"properties": {"payload": {"$ref": "graph.schema.json#/$defs/tag"}}}},
    {"if": {"properties": {"kind": {"const": "relation.added"}}}, "then": {"properties": {"payload": {"$ref": "graph.schema.json#/$defs/relation"}}}}
    ,{"if": {"properties": {"kind": {"const": "decision.accepted"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/accepted"}}}}
    ,{"if": {"properties": {"kind": {"const": "decision.rejected"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/rejected"}}}}
    ,{"if": {"properties": {"kind": {"const": "decision.judgment_resolved"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/judgment_resolution"}}}}
    ,{"if": {"properties": {"kind": {"const": "decision.superseded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/supersession"}}}}
    ,{"if": {"properties": {"kind": {"const": "work.note_added"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/note"}}}}
    ,{"if": {"properties": {"kind": {"enum": ["work.finished"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/outcome"}}}}
    ,{"if": {"properties": {"kind": {"enum": ["work.abandoned", "work.reopened"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reason"}}}}
    ,{"if": {"properties": {"kind": {"enum": ["area.archived", "area.restored"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/state_change"}}}}
    ,{"if": {"properties": {"kind": {"const": "tag.merged"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/tag_merge"}}}}
    ,{"if": {"properties": {"kind": {"const": "intent_review.resolved"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/review_resolution"}}}}
    ,{"if": {"properties": {"kind": {"const": "relation.removed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/relation_removal"}}}}
    ,{"if": {"properties": {"kind": {"const": "intent_review.recorded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/intent_review"}}}}
    ,{"if": {"properties": {"kind": {"const": "evidence.revised"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/evidence_revision"}}}}
    ,{"if": {"properties": {"kind": {"const": "evidence.redacted"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/evidence_redaction"}}}}
    ,{"if": {"properties": {"kind": {"enum": ["decision.proposed", "decision.revised", "decision.accepted", "decision.rejected", "decision.judgment_resolved", "decision.superseded", "work.created", "work.revised", "work.note_added", "work.finished", "work.abandoned", "work.reopened", "area.created", "area.revised", "area.archived", "area.restored", "tag.created", "tag.revised", "tag.merged", "intent_review.recorded", "intent_review.resolved"]}}}, "then": {"properties": {"record_key": {"minLength": 1}}}}
  ]
}
